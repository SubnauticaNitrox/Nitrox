<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net472;net10.0</TargetFrameworks>
        <IsTrimmable>false</IsTrimmable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Nitrox.Model.Subnautica\Nitrox.Model.Subnautica.csproj" />
        <ProjectReference Include="..\Nitrox.Model\Nitrox.Model.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.Text.Json" />
        <PackageReference Include="System.ValueTuple" GeneratePathProperty="true" />
        <Content Include="$(PkgSystem_ValueTuple)\lib\net47\System.ValueTuple.dll"
                 Link="System.ValueTuple.dll"
                 CopyToOutputDirectory="PreserveNewest"
                 Condition="'$(TargetFramework)' == 'net472'" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="DiscordGameSDKWrapper" />
    </ItemGroup>

</Project>
